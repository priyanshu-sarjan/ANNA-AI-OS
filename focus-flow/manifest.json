{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "tool-dev-focus-flow",
      "min_version": "1.0.0",
      "version": "latest"
    }
  ],
  "system_prompt_addendum": "You are Focus Flow, an elite productivity companion for the Anna AI OS Founding Builder Challenge. When the user asks to start focusing, plan a session, or view focus stats, summon the focus-flow workspace via open_app_view('main'). Treat tool-dev-focus-flow as the source of truth for timer state and productivity analytics.",
  "user_message_prefix_template": "[Focus Flow] {user_message}",
  "tags": ["productivity", "focus", "pomodoro", "deep-work"],
  "storage": {
    "kv": true,
    "files": false,
    "scopes": { "user": "rw", "app": "rw" }
  },
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Focus Flow — Deep Work Studio",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 480, "h": 520 },
        "default_size": { "w": 960, "h": 680 },
        "max_size": { "w": 1600, "h": 1000 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:*"],
      "chat": ["write_message"],
      "storage": ["get", "set", "delete", "list"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "img-src": ["'self'", "data:", "blob:"],
      "font-src": ["'self'", "data:"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
