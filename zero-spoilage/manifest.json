{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "tool-dev-zero-spoilage",
      "min_version": "1.0.0",
      "version": "latest"
    }
  ],
  "system_prompt_addendum": "You are 0-Spoilage (AgriFresh), an AI-powered smart pantry tracker and perishable food waste prevention assistant for the Anna AI OS Founding Builder Challenge. When the user asks to log groceries, check expiring food, get zero-waste recipe suggestions, analyze produce quality/ripeness, or check farm traceability, summon the zero-spoilage workspace via open_app_view('main'). Treat tool-dev-zero-spoilage as the primary execution engine.",
  "user_message_prefix_template": "[0-Spoilage] {user_message}",
  "tags": ["zero-spoilage", "food-waste", "pantry", "recipes", "agrifresh"],
  "storage": {
    "kv": true,
    "files": false,
    "scopes": { "user": "rw", "app": "rw" }
  },
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "0-Spoilage — Smart Pantry & Farm-to-Fork Studio",
        "default": true,
        "entry": "index.html",
        "min_size": { "w": 480, "h": 520 },
        "default_size": { "w": 1040, "h": 720 },
        "max_size": { "w": 1600, "h": 1000 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:*"],
      "chat": ["write_message"],
      "storage": ["get", "set", "delete", "list"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {
      "img-src": ["'self'", "data:", "blob:"],
      "font-src": ["'self'", "data:"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
